# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.npm/
yarn.lock

# Keep package-lock.json for reproducible installs (do NOT ignore it)
# package-lock.json  ← intentionally NOT ignored

# ── Environment Variables & Secrets ───────────────────────────────────────────
# Never commit credentials. Add them as Render / Netlify env vars instead.
.env
.env.*
!.env.example

# ── Cloudinary / Tesseract OCR assets ─────────────────────────────────────────
*.traineddata

# ── Python helper scripts (one-off, not part of the app) ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
write_html.py
rewrite_index.py

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Build & Output Directories ────────────────────────────────────────────────
build/
dist/
out/
.output/

# ── OS-Generated Files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ── Deployment Configs ────────────────────────────────────────────────────────
.netlify/
.vercel/
.env.local
.env.production
.env.staging

# ── Cache ─────────────────────────────────────────────────────────────────────
.cache/
*.cache
.parcel-cache/

# ── Temporary / Scratch Files ─────────────────────────────────────────────────
*.tmp
*.temp
/tmp/
